{
  "name": "dsh-plugin-session-delete",
  "version": "0.3.1",
  "description": "Delete the current session from the conversation header — detaches the live session and removes its persisted directory (port for dsh 0.2.1-rc.x)",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session-delete",
    "session"
  ],
  "author": "chuling-lingling",
  "contributors": [
    {
      "name": "BeiFaXianLe",
      "url": "https://github.com/BeiFaXianLe"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/BeiFaXianLe/dsh-plugin-session-delete.git"
  },
  "homepage": "https://github.com/BeiFaXianLe/dsh-plugin-session-delete#readme",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT"
}
